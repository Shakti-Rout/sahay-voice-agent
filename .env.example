# ==============================================================================
# NHAA (14566) Trauma Voice Agent - Environment Configuration
# ==============================================================================

# Application Environment
APP_NAME="NHAA-TraumaVoiceAgent"
ENVIRONMENT="development"        # development, staging, production
DEBUG=true
PORT=8000
HOST="0.0.0.0"
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Helpline & Telephony Identities
PRODUCTION_HELPLINE_NUMBER="14566"
TELEPHONY_PROVIDER="mock"        # "mock", "exotel"

# Exotel Telephony Credentials (for live carrier calls)
EXOTEL_ACCOUNT_SID="your_exotel_account_sid"
EXOTEL_API_KEY="your_exotel_api_key"
EXOTEL_API_TOKEN="your_exotel_api_token"
EXOTEL_SUB_DOMAIN="api.exotel.com"
EXOTEL_VIRTUAL_NUMBER="your_exophone_number"
EXOTEL_APP_ID="your_exotel_app_id"

# Sarvam AI Credentials (STT: Saaras v3, TTS: Bulbul)
SARVAM_API_KEY="your_sarvam_api_key"
SARVAM_BASE_URL="https://api.sarvam.ai"

# Government BHASHINI Credentials (ASR, NMT, TTS)
BHASHINI_API_KEY="your_bhashini_api_key"
BHASHINI_USER_ID="your_bhashini_user_id"
BHASHINI_AUTH_TOKEN="your_bhashini_auth_token"
BHASHINI_INFERENCE_URL="https://dhruva-api.bhashini.gov.in"

# Gemini LLM Provider (Conversational Reasoning & NLU)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"

# Supabase (PostgreSQL, Vector Store, Auth, Realtime)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Local AI / Audio Processing Settings
VAD_CONFIDENCE_THRESHOLD=0.5
AUDIO_SAMPLE_RATE_TELEPHONY=8000
AUDIO_SAMPLE_RATE_PROCESSING=16000
WAV2VEC2_SER_MODEL="ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition"
USE_GPU=false                     # true if CUDA GPU available, false for CPU INT8

# Safety & Triage Thresholds
DISTRESS_THRESHOLD_MODERATE=0.35
DISTRESS_THRESHOLD_HIGH=0.65
DISTRESS_THRESHOLD_CRITICAL=0.85
BARGE_IN_TRIGGER_DURATION_MS=160
